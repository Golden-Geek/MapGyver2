# Activate only after the lab runner/environment and actual qualification script exist.
# This workflow deliberately has no pull_request or pull_request_target trigger.
name: Trusted hardware qualification
on:
  workflow_dispatch:
    inputs:
      suite:
        description: Bounded physical-hardware suite
        required: true
        type: choice
        default: interop
        options: [interop, recovery, capacity]
permissions:
  contents: read
jobs:
  hardware:
    if: github.ref == 'refs/heads/main'
    environment: projection-hardware
    runs-on: [self-hosted, Windows, X64, projection-gpu-lab]
    timeout-minutes: 180
    env:
      QUALIFICATION_SUITE: ${{ inputs.suite }}
      TESTED_SOURCE_SHA: ${{ github.sha }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          clean: true
      - name: Run trusted source and record physical evidence
        shell: pwsh
        run: |
          python tools/ci/bootstrap.py --triplet x64-windows
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          python tools/qualification/run_lab.py --suite $env:QUALIFICATION_SUITE --source-sha $env:TESTED_SOURCE_SHA --output out/qualification
          exit $LASTEXITCODE
      - name: Retain qualification manifest and results
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: hardware-${{ inputs.suite }}-${{ github.sha }}
          path: out/qualification/
          if-no-files-found: error
          retention-days: 30
