{
	"name": "mapgyver-workspace",
	"private": true,
	"version": "0.0.0",
	"license": "GPL-3.0-only",
	"packageManager": "npm@11.17.0",
	"engines": {
		"node": ">=26.5.0 <27",
		"npm": ">=11.17.0 <12"
	},
	"workspaces": [
		"apps/mapgyver/ui",
		"tools/mapgyver/native-probe/ui",
		"golden/packages/golden-graph-ui",
		"golden/packages/golden-ui",
		"golden/packages/golden-video-ui"
	],
	"scripts": {
		"clean": "powershell -NoProfile -File tools/workspace-hygiene.ps1 -Action Clean -KeepDependencies -KeepSdks",
		"clean:preview": "npm run clean -- -WhatIf",
		"clean:check": "powershell -NoProfile -File tools/workspace-hygiene.ps1 -Action Audit",
		"dev:mapgyver": "npm run dev --workspace mapgyver-ui",
		"build:mapgyver": "npm run build --workspace mapgyver-ui",
		"check:mapgyver": "npm run check --workspace mapgyver-ui",
		"run:mapgyver": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/mapgyver/ffmpeg/with-ffmpeg.ps1 run --package MapGyver",
		"watch:mapgyver": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/mapgyver/ffmpeg/with-ffmpeg.ps1 xtask watch",
		"package:mapgyver": "node tools/release/check-signing.mjs && npm run build:mapgyver && powershell -NoProfile -ExecutionPolicy Bypass -File tools/mapgyver/ffmpeg/with-ffmpeg.ps1 --tauri build",
		"package:check:mapgyver": "node tools/release/check-signing.mjs && npm run build:mapgyver && powershell -NoProfile -ExecutionPolicy Bypass -File tools/mapgyver/ffmpeg/with-ffmpeg.ps1 --tauri build --no-bundle",
		"package:mapgyver:macos": "bash tools/mapgyver/ffmpeg/bundle-macos.sh",
		"package:mapgyver:linux": "bash tools/mapgyver/package-linux.sh",
		"dev": "npm run dev:mapgyver",
		"build": "npm run build:mapgyver",
		"check": "npm run check:mapgyver && npm run check --workspace mapgyver-native-probe-ui",
		"lint": "npm run lint --workspace mapgyver-ui",
		"format": "npm run format --workspace mapgyver-ui",
		"package": "npm run package:mapgyver",
		"package:check": "npm run package:check:mapgyver"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.11.4"
	}
}
