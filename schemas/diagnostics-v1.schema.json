{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Golden-Geek/MapGyver2/schemas/diagnostics-v1.schema.json",
  "title": "MapGyver diagnostic report v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "build", "platform", "gpu", "features"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "MapGyver" }, "version": { "type": "string", "minLength": 1 } }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "dirty", "configuration", "compiler", "cmakeVersion"],
      "properties": {
        "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": ["boolean", "null"] },
        "configuration": { "type": "string", "minLength": 1 },
        "cmakeVersion": { "type": "string", "minLength": 1 },
        "compiler": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["os", "architecture", "pointerBits", "byteOrder"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["x64", "arm64", "unknown"] },
        "pointerBits": { "enum": [32, 64] }, "byteOrder": { "enum": ["little", "big", "mixed"] }
      }
    },
    "gpu": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": { "status": { "enum": ["not_probed", "unavailable"] }, "reason": { "type": "string", "minLength": 1 } }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "media", "ui", "hardwareTests", "ndi"],
      "properties": {
        "platform": { "$ref": "#/$defs/feature" }, "media": { "$ref": "#/$defs/feature" },
        "ui": { "$ref": "#/$defs/feature" }, "hardwareTests": { "$ref": "#/$defs/feature" }, "ndi": { "$ref": "#/$defs/feature" }
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object", "additionalProperties": false, "required": ["configured", "available", "reason"],
      "properties": {
        "configured": { "type": "boolean" }, "available": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
