+	// MapGyver contribution: SPDX-License-Identifier: GPL-3.0-or-later
+	uintptr_t overrideInternal2D(TextureHandle _handle, uintptr_t _ptr, uint16_t _width, uint16_t _height)
+	{
+		BGFX_CHECK_RENDER_THREAD();
+		if (BX_ENABLED(BGFX_CONFIG_MULTITHREADED)
+		|| RendererType::Direct3D11 != getRendererType()
+		|| 0 == _ptr || 0 == _width || 0 == _height
+		|| _width > g_caps.limits.maxTextureSize || _height > g_caps.limits.maxTextureSize)
+		{
+			return 0;
+		}
+		BGFX_CHECK_HANDLE("overrideInternal2D", s_ctx->m_textureHandle, _handle);
+		TextureRef& ref = s_ctx->m_textureRef[_handle.idx];
+		if (ref.isCubeMap() || ref.is3D() || 1 != ref.m_numMips
+		|| 1 != ref.m_numLayers || 1 != ref.m_numSamples || 1 != ref.m_refCount
+		|| BackbufferRatio::Count != ref.m_bbRatio)
+		{
+			return 0;
+		}
+		uint32_t stride = 0;
+		switch (TextureFormat::Enum(ref.m_format))
+		{
+		case TextureFormat::RGBA8:  stride = 4;  break;
+		case TextureFormat::RGBA16F: stride = 8;  break;
+		case TextureFormat::RGBA32F: stride = 16; break;
+		default: return 0;
+		}
+		const uint64_t storage = uint64_t(_width) * _height * stride;
+		if (storage > UINT32_MAX) return 0;
+		const uintptr_t result = overrideInternal(_handle, _ptr);
+		if (0 == result) return 0;
+		const int64_t delta = int64_t(storage) - ref.m_storageSize;
+		if (ref.isRt()) s_ctx->m_rtMemoryUsed += delta;
+		else s_ctx->m_textureMemoryUsed += delta;
+		ref.m_width = _width;
+		ref.m_height = _height;
+		ref.m_storageSize = uint32_t(storage);
+		return result;
 	}
 
